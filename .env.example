# Copy this file to .env. Keep secrets out of source control.
DATABASE_URL=sqlite:///data/careerlens.db
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=data/indexes
DEMO_IDENTITY=local-demo
RRF_CONSTANT=60
# Optional JSON override; weights are normalized over available evidence.
RECOMMENDATION_WEIGHTS={"semantic":0.38,"skills":0.25,"experience":0.15,"location":0.10,"preferences":0.08,"salary":0.04}
